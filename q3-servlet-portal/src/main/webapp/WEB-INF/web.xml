<?xml version="1.0" encoding="UTF-8"?>
<!--
    File    : WEB-INF/web.xml   (Deployment Descriptor)
    Author  : S B GOKUL (24CS067)
    Purpose : Configures the database settings, servlets, URL mappings,
              the login filter, session handling and error pages.
    Server  : Apache Tomcat 10.x / 11.x  (Jakarta Servlet API)
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
         version="5.0">

    <display-name>KPRIET Student Profile Portal</display-name>

    <!-- ============ 1. Database and upload folder settings ============ -->
    <context-param>
        <param-name>jdbcDriver</param-name>
        <param-value>com.mysql.cj.jdbc.Driver</param-value>
    </context-param>
    <context-param>
        <param-name>jdbcUrl</param-name>
        <param-value>jdbc:mysql://localhost:3306/student_portal?useSSL=false&amp;allowPublicKeyRetrieval=true</param-value>
    </context-param>
    <context-param>
        <param-name>jdbcUser</param-name>
        <param-value>root</param-value>
    </context-param>
    <context-param>
        <param-name>jdbcPassword</param-name>
        <param-value></param-value>
    </context-param>

    <!-- Folder of the PHP project (Q2). The images / documents uploaded there
         are read from <uploadBaseDir>/uploads/... and streamed by FileStreamServlet -->
    <context-param>
        <param-name>uploadBaseDir</param-name>
        <param-value>C:/xampp/htdocs/q2-php-admin-panel</param-value>
    </context-param>

    <!-- ============ 2. Login filter: protects every URL ============ -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.kpriet.portal.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ============ 3. Servlets and their URL mappings ============ -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.kpriet.portal.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.kpriet.portal.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StudentListServlet</servlet-name>
        <servlet-class>com.kpriet.portal.servlet.StudentListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentListServlet</servlet-name>
        <url-pattern>/students</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StudentProfileServlet</servlet-name>
        <servlet-class>com.kpriet.portal.servlet.StudentProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FileStreamServlet</servlet-name>
        <servlet-class>com.kpriet.portal.servlet.FileStreamServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FileStreamServlet</servlet-name>
        <url-pattern>/file</url-pattern>
    </servlet-mapping>

    <!-- ============ 4. Session configuration ============ -->
    <session-config>
        <session-timeout>15</session-timeout>           <!-- minutes of inactivity -->
        <cookie-config>
            <http-only>true</http-only>                 <!-- JavaScript cannot read it -->
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>           <!-- no ;jsessionid in URLs -->
    </session-config>

    <!-- ============ 5. Welcome page and error pages ============ -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <error-page>
        <error-code>400</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
</web-app>
